---
import Container from "@/components/Container.astro";
import { APK_URL, BETA_URL, EMAIL } from "@/links";

// The mark is a week of the timetable, Mon–Fri with four periods, drawn like the app icon:
// [weekday, first period, periods, colour]
const lessons: [number, number, number, string][] = [
  [0, 0, 2, "var(--color-deutsch)"],
  [0, 2, 2, "var(--color-rzg)"],
  [1, 0, 2, "var(--color-mathe)"],
  [1, 2, 1, "var(--color-nt)"],
  [1, 3, 1, "var(--color-ink-soft)"],
  [2, 0, 2, "var(--color-englisch)"],
  [2, 2, 2, "var(--color-deutsch)"],
  [3, 0, 2, "var(--color-nt)"],
  [3, 2, 2, "var(--color-mathe)"],
  [4, 0, 1, "var(--color-rzg)"],
  [4, 1, 1, "var(--color-ink-soft)"],
  [4, 2, 2, "var(--color-englisch)"],
];
const blocks = lessons.map(([day, period, span, color]) => ({
  style: `grid-column: ${day + 1}; grid-row: ${period + 1} / span ${span}; background: ${color}`,
}));

const link =
  "inline-block py-[3px] no-underline transition-colors duration-150 hover:text-white active:text-white";
---

<footer class="flex min-h-svh flex-col bg-ink pt-[clamp(3rem,6vw,4.5rem)] pb-8 text-faint">
  <Container width="full" class="flex flex-1 flex-col">
    <!--
      A grid instead of a fixed drawing: in landscape it keeps the 10:3 shape, in portrait it grows
      into the free height of the footer, so the links never sit far below it.
    -->
    <div
      class="grid flex-1 grid-cols-5 grid-rows-4 gap-[1.2vw] landscape:flex-none landscape:aspect-[10/3]"
      role="img"
      aria-label="SchoolOS">
      {blocks.map(({ style }) => (
        <span class="rounded-[2.4vw]" style={style} />
      ))}
    </div>
    <div class="mt-auto grid gap-8 pt-12 sm:grid-cols-[1fr_1fr_1.4fr]">
      <ul>
        <li>
          <a class={link} href="/installieren/">
            Installieren
          </a>
        </li>
        <li>
          <a class={link} href={BETA_URL}>
            TestFlight-Einladung
          </a>
        </li>
        <li>
          <a class={link} href={APK_URL}>
            APK für Android
          </a>
        </li>
      </ul>
      <ul>
        <li>
          <a class={link} href="/fragen/">
            Fragen
          </a>
        </li>
        <li>
          <a class={link} href="/feedback/">
            Feedback
          </a>
        </li>
        <li>
          <a class={link} href="https://github.com/JaroxCraft/SchoolOS">
            Quellcode
          </a>
        </li>
      </ul>
      <p>
        Ein Projekt von Nico Fäh, entstanden als Selbständige Projektarbeit im Schuljahr 2026/27.
      </p>
    </div>
    <div class="mt-12 flex items-center justify-between gap-4 text-small">
      <span>© 2026 Nico Fäh</span>
      <a class={link} href={`mailto:${EMAIL}?subject=SchoolOS`}>
        {EMAIL}
      </a>
    </div>
  </Container>
</footer>
