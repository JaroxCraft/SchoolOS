---
import Button from "@/components/Button.astro";
import PageHead from "@/components/PageHead.astro";
import Base from "@/layouts/Base.astro";
import { EMAIL } from "@/links";
---

<Base
  title="Feedback zu SchoolOS"
  description="Melde Fehler und Wünsche zur Testversion von SchoolOS über die Umfrage, per E-Mail oder direkt in TestFlight."
  current="feedback">
  <PageHead
    id="feedback-title"
    title="Feedback"
    lead="Fehler, Wünsche, Verwirrendes: Alles hilft. Die Umfrage bitte erst nach mehreren Wochen Testen ausfüllen.">
    <p
      class="rise mt-10 flex flex-wrap justify-center gap-3 max-sm:mx-auto max-sm:max-w-xs max-sm:flex-col max-sm:items-stretch"
      style="--i: 2">
      <span
        aria-disabled="true"
        title="Die Umfrage ist noch nicht geöffnet"
        class="inline-flex min-h-12 cursor-not-allowed items-center justify-center rounded-ui bg-surface px-6 font-medium text-muted">
        Umfrage noch nicht offen
      </span>
      <Button href={`mailto:${EMAIL}`} variant="quiet">
        {EMAIL}
      </Button>
    </p>
    <p class="rise mx-auto mt-8 max-w-[44ch] text-small text-muted" style="--i: 3">
      <strong class="font-medium text-ink">Auf dem iPhone:</strong> Mach in SchoolOS einen
      Screenshot, tippe auf die Vorschau, tippe auf Teilen und dann auf "Beta Feedback senden".
    </p>
  </PageHead>
</Base>
